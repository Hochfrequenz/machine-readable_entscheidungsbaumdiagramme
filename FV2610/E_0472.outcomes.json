    "section": "6.12.4: AD: Unterbrechung der Anschlussnutzung (Sperren) auf Anweisung des LF",
    "ebd_name": "E_0472_Prüfen, ob Sperrauftrag erfolgreich",
    "role": "NB",
    "remark": null,
