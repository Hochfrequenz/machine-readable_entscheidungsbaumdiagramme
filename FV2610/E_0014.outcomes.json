      "step_number": "1",
      "question": "Entspricht die Gültigkeit (Monat) dem angefragten Zeitraum?",
      "note": null
    },
    {
      "step_number": "2",
      "question": "Entspricht der MaBiS-ZP dem angefragten MaBiS-ZP?",
      "note": null
    },
    {
      "step_number": "3",
      "question": "Entspricht die Versionsangabe in der LF-CL der Versionsangabe der LF-SZR (Kategorie B), zu der eine LF-CL angefordert wurde?",
      "note": null
    },
    {
      "step_number": "4",
      "question": "Ist eine erwartete Marktlokation in der LF-CL nicht enthalten?",
      "note": null
    },
    {
      "step_number": "5",
      "question": "Ist in der LF-CL eine Marktlokation enthalten, die im Bilanzierungsmonat dem LF zur Bilanzierung nicht zugeordnet ist?",
      "note": null
    },
    {
      "step_number": "6",
      "question": "Ist die in der LF-CL enthaltene Marktlokation dem MaBiS-ZP zugeordnet?",
      "note": null
    },
    {
      "step_number": "7",
      "question": "Entspricht das Bilanzierungsgebiet dem zwischen NB und LF ausgetauschten Bilanzierungsgebiet?",
      "note": null
    },
    {
      "step_number": "8",
      "question": "Entspricht der Bilanzkreis dem zwischen NB und LF ausgetauschten Bilanzkreis?",
