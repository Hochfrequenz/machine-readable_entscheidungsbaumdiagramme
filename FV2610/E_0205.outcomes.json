  "steps": [
    {
      "step_number": "10",
      "question": "Liegt ein gültiger Vertrag zwischen MSB und LF vor, der die Rechnungsabwicklung des Messstellenbetriebs an den LF regelt?",
      "note": null
    },
    {
      "step_number": "20",
      "question": "Sind alle Messlokationen der angefragten Marktlokationen mit kME ausgestattet?",
      "note": null
    },
    {
      "step_number": "30",
      "question": "Lässt das Vertragsverhältnis mit dem Kunden die Abrechnung des Messstellenbetriebs zu?",
      "note": null
    },
    {
      "step_number": "40",
      "question": "Lässt das Vertragsverhältnis mit dem Kunden das im Angebot benannte Beginndatum zum Messstellenbetrieb zu?",
      "note": null
    },
    {
      "step_number": "50",
      "question": "Handelt es sich um ein Angebot auf Basis eines Preisblattes?",
      "note": null
    },
    {
      "step_number": "70",
      "question": "Liegt dem LF ein gültiges Preisblatt mit allen im Angebot an-gegebenen Preisschlüsselstämmen bzw. mit allen im Angebot angegebenen Artikel-ID vor?",
      "note": null
    },
    {
      "step_number": "80",
      "question": "Entsprechen die angebotenen Positionen dem Vertragsverhältnis mit dem Kunden?",
      "note": null
    }
  ],
