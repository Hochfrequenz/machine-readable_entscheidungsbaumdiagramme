  "steps": [
    {
      "step_number": "5",
      "question": "Handelt es sich um eine Berechnungsformel für eine Marktlokation?",
      "note": null
    },
    {
      "step_number": "10",
      "question": "Handelt es sich um eine Berechnungsformel für eine Netzlokation?",
      "note": null
    },
    {
      "step_number": "15",
      "question": "Handelt es sich bei dem „Verwendungszeitraum der Daten“ um einen Zeitraum mit dem Status „keine Daten“?",
      "note": null
    },
    {
      "step_number": "18",
      "question": "Werden für den Verwendungszeitraum der Daten mit dem Status „keine Daten“ Daten erwartet?",
      "note": null
    },
    {
      "step_number": "20",
      "question": "Ist im Geschäftsvorfall der Status der Berechnungsformel mit „Berechnungsformel muss beim Absender angefragt werden“ angegeben?",
      "note": null
    },
    {
      "step_number": "30",
      "question": "Ist im Geschäftsvorfall der Status der Berechnungsformel mit „Berechnungsformel besitzt keine Rechenoperation“ angegeben?",
      "note": null
    },
    {
      "step_number": "40",
      "question": "Ist in den zuvor ausgetauschten Stammdatenmeldungen (z.B. Anmeldebestätigung, Stammdatenänderung (inklusive Lokationsbündelstrukturänderung)) für den betroffenen Zeitraum genau eine Messlokation dieser Lokation zugeordnet?",
      "note": null
    },
    {
      "step_number": "50",
      "question": "Liegt eine Änderung der Lokationsbündelstruktur durch den NB vor, die durch Stammdatenänderung übermittelt wurde?",
      "note": null
    },
    {
      "step_number": "60",
      "question": "Ist der Zeitraum der Zeitraum-ID der Berechnungsformel identisch mit dem Zeitraum der Strukturänderung des Lokationsbündels?",
      "note": null
    },
    {
      "step_number": "70",
      "question": "Ist die Anzahl der gemeldeten / vorliegenden Mess-lokationen aus den Stammdatenmeldungen (z. B. Anmeldebestätigung, Stammdatenänderung) gemäß dem Zeitraum kleiner als in der Berechnungsformel?",
      "note": null
    },
    {
      "step_number": "80",
      "question": "Ist die Anzahl gemäß der gemeldeten/vorliegenden Messlokationen aus den Stammdatenmeldungen (z. B. Anmeldebestätigung, Stammdatenänderung) gemäß dem Zeitraum größer als in der Berechnungsformel?",
      "note": null
    },
    {
      "step_number": "90",
      "question": "Sind alle ID der Messlokationen in der Berechnungsformel mit den zuvor in den Stammdatenmeldungen (z. B. Anmeldebestätigung, Stammdatenänderung) gemeldeten ID der Messlokationen für diesen Zeitraum identisch?",
      "note": null
    },
    {
      "step_number": "100",
      "question": "Existiert für jede Flussrichtung der in der Berechnungsformel vorhandenen Messlokationen mindestens eine zuvor in den Stammdatenmeldungen (z. B. Anmeldebestätigung, Stammdatenänderung) ausgetauschte OBIS-Kennzahl* mit identischer Flussrichtung?",
      "note": null
    },
    {
      "step_number": "110",
      "question": "Ist ein zuvor nicht spezifizierter Fehler aufgetreten?",
      "note": null
    },
    {
      "step_number": "120",
      "question": "Sind noch weitere Verwendungszeiträume zu prüfen?",
      "note": null
    }
  ],
  "multi_step_instructions": [
    {
      "first_step_number_affected": "15",
      "instruction_text": "Die nachfolgenden Prüfungen werden, beginnend mit der ersten Zeitraum-ID, für jeden Zeitraum durchgeführt. Tritt in einem Zeitraum der erste Fehler auf, so sind für diesen Zeitraum keine weiteren Prüfungen durchzuführen. Alle in den Zeiträumen gefundene Fehler sind, unter Nennung der jeweiligen Zeitraum-ID, zu nennen."
    }
  ],
