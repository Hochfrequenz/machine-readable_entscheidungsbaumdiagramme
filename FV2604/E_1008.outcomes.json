  "steps": [
    {
      "step_number": "10",
      "question": "Bezieht sich das Nicht-Zahlungsavis auf eine Rechnung der Kategorie „Unterbrechung der Anschlussnutzung (Sperren)“?",
      "note": null
    },
    {
      "step_number": "20",
      "question": "Bezieht sich das Nicht-Zahlungsavis auf eine Rechnung der Kategorie „Verzugskosten“?",
      "note": null
    },
    {
      "step_number": "30",
      "question": "Hat der Lieferant wegen fehlendem Preisblatt „Preisblatt Sperren / Entsperren und Verzugskosten“ abgelehnt?",
      "note": null
    },
    {
      "step_number": "40",
      "question": "Wurde dem Lieferanten ein für die Rechnung gültiges Preisblatt versendet?",
      "note": null
    },
    {
      "step_number": "50",
      "question": "Hat der Lieferant wegen unbekanntem Sperrauftrag abgelehnt?",
      "note": null
    },
    {
      "step_number": "60",
      "question": "Liegt ein bestätigter Sperrauftrag mit der angegebenen Referenz auf den Sperrauftrag des Lieferanten vor?",
      "note": null
    },
    {
      "step_number": "70",
      "question": "Hat der Lieferant die Rechnung wegen Angabe einer falschen Artikel-ID abgelehnt?",
      "note": null
    },
    {
      "step_number": "80",
      "question": "Hat der LF den Sperrauftrag storniert und wurde diese Stornierung vom NB bestätigt?",
      "note": null
    },
    {
      "step_number": "90",
      "question": "Wurde die korrekte Artikel-ID entsprechend eines stornierten Sperrauftrags in der Rechnung angegeben?",
      "note": null
    },
    {
      "step_number": "100",
      "question": "Wurde die korrekte Artikel-ID entsprechend dem Ergebnis des Sperrauftrags in der Rechnung angegeben?",
      "note": null
    },
    {
      "step_number": "110",
      "question": "Hat der Lieferant die Rechnung abgelehnt, da auf der Rechnung ein, zum Preisblatt abweichender Preis angegeben wurde?",
      "note": null
    },
    {
      "step_number": "120",
      "question": "Wurde in der Rechnung der im Preisblatt angegebene Preis abgerechnet?",
      "note": null
    },
    {
      "step_number": "130",
      "question": "Ergibt die Prüfung der abgelehnten Rechnung, dass die Ablehnung durch den Lieferanten gerechtfertigt war?",
      "note": null
    },
    {
      "step_number": "140",
      "question": "Hat der Lieferant wegen fehlendem Preisblatt „Preisblatt Sperren / Entsperren und Verzugskosten“ abgelehnt?",
      "note": null
    },
    {
      "step_number": "150",
