  "steps": [
    {
      "step_number": "5",
      "question": "Ist die Anfrage ausgehend vom ÜT der Lieferanmeldung bis 07:00 Uhr des nächsten Werktages eingegangen?",
      "note": null
    },
    {
      "step_number": "10",
      "question": "Wurde der Anwendungsfall für eine verbrauchende Marktlokation verwendet?",
      "note": null
    },
    {
      "step_number": "20",
      "question": "Besteht zum Folgetag des in der Anfrage zur Beendigung der Zuordnung genannten Termins eine Zuordnung für diese Marktlokation?\nHinweis: Ist der Kunde in der E/G, ist diese Frage ebenfalls mit ja zu beantworten",
      "note": null
    },
    {
      "step_number": "30",
      "question": "Liegt dem LFA bereits eine bestätigtes Zuordnungsende vor?",
      "note": null
    },
    {
      "step_number": "40",
      "question": "Liegt in der Anfrage zur Beendigung der Zuordnung der Transaktionsgrund Ein-/ Auszug (Umzug) vor?",
      "note": null
    },
    {
      "step_number": "50",
      "question": "Ist der Kunde aus der Anfrage zur Beendigung der Zuordnung identisch mit dem Kunden beim LFA?",
      "note": null
    },
    {
      "step_number": "60",
      "question": "Hat der LFA Informationen darüber, dass sein Kunde nicht ausgezogen ist?",
      "note": null
    },
    {
      "step_number": "70",
      "question": "Ist der LFA ein Lieferant der auch Grundversorger ist?",
      "note": null
    },
    {
      "step_number": "80",
      "question": "Befindet sich die Marktlokation zum Folgetag des Enddatums aus der Anfrage zur Beendigung der Zuordnung in der Ersatz-versorgung?",
      "note": null
    },
    {
      "step_number": "90",
      "question": "Bleibt das Vertragsverhältnis des LFA mit dem Kunden an dieser Marktlokation / Tranchen zum Tag nach dem Enddatum aus der Anfrage zur Beendigung der Zuordnung bestehen?",
      "note": null
    },
    {
      "step_number": "200",
      "question": "Besteht zum Folgetag des in der Anfrage zur Beendigung der Zuordnung genannten Termins eine Zuordnung für diese Marktlokation / Tranche?",
      "note": null
    },
    {
      "step_number": "210",
      "question": "Liegt dem LFA bereits eine bestätigtes Zuordnungsende vor?",
      "note": null
    },
    {
      "step_number": "220",
      "question": "Bleibt das Vertragsverhältnis des LFA mit dem Kunden an dieser Marktlokation / Tranche zum Tag nach dem Enddatum aus der Anfrage zur Beendigung der Zuordnung bestehen?",
      "note": null
    }
  ],
