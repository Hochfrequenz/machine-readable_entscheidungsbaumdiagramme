  "steps": [
    {
      "step_number": "1",
      "question": "Ist das vom ESA gewünschte Messprodukt in der Codeliste der Konfigurationen als „Pflicht“ gekennzeichnet?",
      "note": null
    },
    {
      "step_number": "2",
      "question": "Wird das vom ESA gewünschte Messprodukt entsprechend der Codeliste der Konfigurationen angeboten?",
      "note": null
    },
    {
      "step_number": "3",
      "question": "Liegt die vertragliche Grundlage zur Anfrage und Übermittlung der Werte und Abrechnung der erbrachten Dienstleistung vom MSB an den ESA beim MSB vor?",
      "note": null
    },
    {
      "step_number": "4",
      "question": "Liegt dem MSB eine gültige datenschutzrechtliche Einwilligung (wie z. B. das BDEW-Muster „Einwilligungserklärung in die Verarbeitung personenbezogener Daten nach DS-GVO - \nAnfrage und Übermittlung von Messprodukten \ngemäß BNetzA-Festlegung BK6-20-160“) zur Anfrage und Übermittlung von Messprodukten vor?",
      "note": null
    },
    {
      "step_number": "5",
      "question": "Sind die Daten in der Einwilligung plausibel und vollständig?",
      "note": null
    },
    {
      "step_number": "6",
      "question": "Ermöglicht die vorhandene Gerätetechnik die Übermittlung der angefragten Werte entsprechend dem Messprodukt?",
      "note": null
    },
    {
      "step_number": "7",
      "question": "Handelt es sich um eine Anfrage von Werten auf Ebene der Marktlokation / Tranche / Netzlokation?",
      "note": null
    },
    {
      "step_number": "8",
      "question": "Ist der MSB an allen der Marktlokation (inkl. Tranche) / Netzlokation zugeordneten Messlokationen auch der MSB der Messlokation(en)?",
      "note": null
    }
  ],
  "multi_step_instructions": null,
