  "steps": [
    {
      "step_number": "1",
      "question": "Liegt ein gültiger Vertrag zwischen MSB und LF vor, der die Rechnungsabwicklung des Messstellenbetriebs an den LF regelt?",
      "note": null
    },
    {
      "step_number": "2",
      "question": "Liegt der angefragte Beginn der Übernahme der Abrechnung des Messstellenbetriebs im Zeitraum einer vom MSB bereits bestätigten Vereinbarung mit dem anfragenden LF zur Abwicklung des Messentgeltes?",
      "note": null
    },
    {
      "step_number": "3",
      "question": "Sind alle Messlokationen der angefragten Marktlokation mit kME ausgestattet?",
      "note": null
    },
    {
      "step_number": "4",
      "question": "Besteht ein Vertrag mit dem Anschlussnehmer gemäß MsbG?",
      "note": null
    },
    {
      "step_number": "5",
      "question": "Besteht ein nicht konkludent geschlossener Vertrag für den Messstellenbetrieb mit dem Anschlussnutzer?",
      "note": null
    },
    {
      "step_number": "6",
      "question": "Ist eine Abrechnung über den LF durch den Vertrag ausgeschlossen?",
      "note": null
    },
    {
      "step_number": "7",
      "question": "Wird das Entgelt bereits über die erzeugende Marktlokation entrichtet?",
      "note": null
    },
    {
      "step_number": "8",
      "question": "Wird das Entgelt über eine andere Marktlokation entrichtet?",
      "note": null
    },
    {
      "step_number": "9",
      "question": "Möchte der MSB zum angefragten Termin kein Angebot erstellen und verzichtet auf die Erstellung und Versendung des Angebots?",
      "note": null
    },
    {
      "step_number": "10",
      "question": "Liegt bereits eine mit dem LF vereinbarte Rechnungsabwicklung für diese Marktlokation zu einem späteren Zeitpunkt vor?",
      "note": null
    },
    {
      "step_number": "11",
      "question": "Liegt der angefragte Beginn der Übernahme der Abrechnung des Messstellenbetriebs in einem bereits vom MSB abgerechneten Zeitraum?",
      "note": null
    },
    {
      "step_number": "12",
      "question": "Hat der LF zum nächstmöglichen Termin angefragt?",
      "note": null
    }
  ],
