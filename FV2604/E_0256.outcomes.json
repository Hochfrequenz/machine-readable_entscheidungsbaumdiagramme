  "steps": [
    {
      "step_number": "1",
      "question": "Ist die Bindungsfrist des Angebots abgelaufen?",
      "note": null
    },
    {
      "step_number": "2",
      "question": "Akzeptiert der MSB die Bestellung auch bei abgelaufener Bindungsfrist?",
      "note": null
    },
    {
      "step_number": "3",
      "question": "Handelt es sich bei der Bestellung um ein Abo?",
      "note": null
    },
    {
      "step_number": "4",
      "question": "Bietet der MSB das gewünschte Messprodukt zum Zeitraum / Zeitpunkt der Messwertermittlung als Abo an?",
      "note": null
    },
    {
      "step_number": "5",
      "question": "Bietet der MSB das gewünschte Messprodukt zum Zeitraum / Zeitpunkt der Messwertermittlung als einmalige Übermittlung an?",
      "note": null
    },
    {
      "step_number": "6",
      "question": "Ist die vertragliche Grundlage zur Anfrage und Übermittlung der Werte und Abrechnung der erbrachten Dienstleistung vom MSB an den ESA beim MSB zum Zeitraum / Zeitpunkt der Messwertermittlung noch gültig?",
      "note": null
    },
    {
      "step_number": "7",
      "question": "Ist der MSB für den im Angebot spezifizierten Zeitraum / Zeitpunkt der Messwertermittlung der entsprechenden Lokation zugeordnet?",
      "note": null
    },
    {
      "step_number": "8",
      "question": "Ist die dem MSB vorliegende datenschutzrechtliche Einwilligung (wie z. B. das BDEW-Muster „Einwilligungserklärung in die Verarbeitung personenbezogener Daten nach DS-GVO - \nAnfrage und Übermittlung von Messprodukten \ngemäß BNetzA-Festlegung BK6-20-160“) zur Anfrage und Übermittlung von Messprodukten zum Zeitraum / Zeitpunkt der Messwertermittlung weiterhin gültig?",
      "note": null
    },
    {
      "step_number": "9",
      "question": "Ermöglicht die vorhandene Gerätetechnik zum Zeitraum / Zeitpunkt der Messwertermittlung die Übermittlung der angefragten Werte entsprechend dem Messprodukt?",
      "note": null
    },
    {
      "step_number": "10",
      "question": "Handelt es sich um eine Bestellung von Werten auf Ebene der Marktlokation / Tranche / Netzlokation?",
      "note": null
    },
    {
      "step_number": "11",
      "question": "Ist der MSB zum Zeitraum / Zeitpunkt der Messwertermittlung an allen der Marktlokation (inkl. Tranche) / Netzlokation zugeordneten Messlokationen auch der MSB der Messlokation?",
      "note": null
    }
  ],
  "multi_step_instructions": null,
