  "steps": [
    {
      "step_number": "10",
      "question": "Ist die Marktlokation bereits gesperrt?",
      "note": null
    },
    {
      "step_number": "20",
      "question": "Liegt für die Marktlokation im Zeitraum von 6 WT ab dem frühestmöglichen Sperrtermin bereits ein Sperrauftrag vor?",
      "note": null
    },
    {
      "step_number": "30",
      "question": "Ist im gesamten Ausführungszeitraum des Sperrauftrags (= frühestmöglicher Sperrtermin bis frühestmöglicher Sperrtermin + 6 WT) der die Sperrung beauftragende LF der zu sperrenden Marktlokation zugeordnet?",
      "note": null
    },
    {
      "step_number": "40",
      "question": "Ist im Zeitraum von 6 WT ab dem frühestmöglichen Sperrtermin an allen Messlokationen, welche der Marktlokation zugeordnet sind, der identische MSB zugeordnet, wie an der zu sperrenden Marktlokation?",
      "note": null
    },
    {
      "step_number": "50",
      "question": "Liegt die zu sperrende Marktlokation in der Niederspannung?",
      "note": null
    },
    {
      "step_number": "60",
      "question": "Sind weitere Marktlokationen von der Sperrung betroffen, für die dieser Sperrauftrag keine Wirkung entfalten darf?\nHinweis: „Ruhende Marktlokationen“ sind bei der Beantwortung der Frage nicht zu berücksichtigen.",
      "note": null
    },
    {
      "step_number": "65",
      "question": "Handelt es sich bei der bzw. den weiteren Marktlokationen ausschließlich um erzeugende Marktlokation(en)?",
      "note": null
    },
    {
      "step_number": "70",
      "question": "Liegt im gesamten Ausführungszeitraum ein bestätigter Lieferbeginn gegenüber dem beauftragenden LF vor?",
      "note": null
    },
    {
      "step_number": "80",
      "question": "Liegt ein Verhinderungsgrund einer Sperrung an der Marktlokation vor?",
      "note": null
    },
    {
      "step_number": "90",
      "question": "Ist der Sperrauftrag termingebunden?",
      "note": null
    },
    {
      "step_number": "100",
      "question": "Liegt der übermittelte Sperrtermin mindestens 12 WT nach dem Eingangsdatum der Nachricht des Sperrauftrags?",
      "note": null
    },
    {
      "step_number": "110",
      "question": "Liegt der übermittelte frühestmögliche Sperrtermin mindestens 6 WT nach dem Eingangsdatum der Nachricht des Sperrauftrags?",
      "note": null
    },
    {
      "step_number": "120",
      "question": "Ist ein zuvor nicht spezifizierter Fehler aufgetreten?",
      "note": null
    },
    {
      "step_number": "130",
      "question": "Kann der Sperrauftrag pauschal über das elektronische Preisblatt abgebildet werden?",
      "note": null
    }
  ],
  "multi_step_instructions": null,
