    "chapter": "GPKE",
    "section": "6.12.1: AD: Unterbrechung der Anschlussnutzung (Sperren) auf Anweisung des LF",
    "ebd_name": "E_0470_Sperrauftrag prüfen",
    "role": "NB",
    "remark": null,
