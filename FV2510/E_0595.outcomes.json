  "metadata": {
    "ebd_code": "E_0595",
    "chapter": "GPKE",
    "section": "6.17.1: AD: Bestellung einer Änderung von Abrechnungsdaten von LF an NB",
    "ebd_name": "E_0595_Bestellung prüfen",
    "role": "NB",
    "remark": null,
    "release_information": {
      "version": "4.1",
