  "steps": [
    {
      "step_number": "10",
      "question": "Handelt es sich bei dem Anwendungsfall um eine Bestellung mittels ORDERS?",
      "note": null
    },
    {
      "step_number": "15",
      "question": "Handelt es sich um eine Bestellung Änderung Netzentgelte aufgrund netzorientierter Steuerungsmöglichkeit?",
      "note": null
    },
    {
      "step_number": "17",
      "question": "Wurde die Vorlauffrist von mindestens 2 WT vor dem Änderungszeitpunkt eingehalten?",
      "note": null
    },
    {
      "step_number": "30",
      "question": "Handelt es sich um eine Bestellung Änderung Konzessionsabgabe?",
      "note": null
    },
    {
      "step_number": "40",
      "question": "Ist der Marktlokation zum Zeitpunkt der bestellten Änderung die Sondervertragskunden-KA zugeordnet?\nHinweis: Wenn der Marktlokation zum Zeitpunkt der bestellten Änderung die Sondervertragskunden-KA zugeordnet ist und die Kriterien nach § 2 Abs. 7 KAV wurden nicht erreicht, so ist diese Frage mit „nein“ zu beantworten.",
      "note": null
    },
    {
      "step_number": "50",
      "question": "Ist die Marktlokation von der Konzessionsabgabe befreit?",
      "note": null
    },
    {
      "step_number": "55",
      "question": "Ist der bestellte Zustand an der Marktlokation bereits vorhanden?",
      "note": null
    },
    {
      "step_number": "60",
      "question": "Bestellt der LF für eine Marktlokation den Wechsel auf eine Schwachlast-Konzessionsabgabe?",
      "note": null
    },
    {
      "step_number": "65",
      "question": "Möchte der NB die Bestellung der rückwirkenden Änderung der Konzessionsabgabe aufgrund rechtlicher Fristen ablehnen?",
      "note": null
    },
    {
      "step_number": "70",
      "question": "Lässt die Gerätekonfiguration der Messlokationen der angefragten Marktlokation zum Umsetzungszeitpunkt die separate Erfassung der Energie in den Schwachlastzeiten zu, um die niedrige Konzessionsabgabe für diese Menge abrechnen zu können?",
      "note": null
    },
    {
      "step_number": "90",
      "question": "Handelt es sich um eine Bestellung Änderung Bilanzkreis bzw. Jahresverbrauchsprognose?",
      "note": null
    },
    {
      "step_number": "100",
      "question": "Wurde die Vorlauffrist von mindestens 7 WT vor dem Änderungszeitpunkt eingehalten?",
      "note": null
    },
    {
      "step_number": "105",
      "question": "Handelt es sich um eine Bestellung Änderung Bilanzkreis?",
      "note": null
    },
    {
      "step_number": "110",
      "question": "Ist der Bilanzkreis zum angegebenen Zeitpunkt in der Regelzone gültig?",
      "note": null
    },
    {
      "step_number": "120",
      "question": "Ist der Bilanzkreis und der erforderliche Zeitreihentyp in der Zuordnungsermächtigung aufgeführt?",
      "note": null
    },
    {
      "step_number": "200",
      "question": "Konnte die Bestellung umgesetzt werden?",
      "note": null
    },
    {
      "step_number": "210",
      "question": "Stimmen alle Stammdaten für Verwendungszeiträume, welche mit „Im System vorhandene Daten“ gekennzeichnet sind, sowie Verwendungszeiträume welche mit „Im System keine Daten vorhanden“ gekennzeichnet sind, mit dem beim Verantwortlichen vorliegenden Stammdaten überein?\nHinweis:\nDies ist für jeden in der Anfrage vorhandenen Verwendungszeitraum jeweils für den gesamten Zeitraum zu prüfen.",
      "note": null
    },
    {
      "step_number": "220",
      "question": "Sind in der Bestellung der Stammdatenänderung Verwendungszeiträume der Daten mit dem Code „Erwartete Daten“ und / oder „Keine Daten erwartet“ enthalten?",
      "note": null
    },
    {
      "step_number": "230",
      "question": "Kommt der Verantwortliche zu dem Ergebnis, dass er Änderungen an seinen Stammdaten vornimmt?",
      "note": null
    },
    {
      "step_number": "240",
      "question": "Sind in der Bestellung der Stammdatenänderung Verwendungszeiträume der Daten mit dem Code „Erwartete Daten“ und / oder „Keine Daten erwartet“ enthalten?",
      "note": null
    },
    {
      "step_number": "250",
      "question": "Kommt der Verantwortliche zu dem Ergebnis, dass er Änderungen an seinen Stammdaten vornimmt?",
      "note": null
    }
  ],
  "multi_step_instructions": null,
