{
  "$defs": {
    "DecisionConsequence": {
      "additionalProperties": false,
      "description": "The forward direction: which result codes are still reachable after a given answer to a decision step.",
      "properties": {
        "answer": {
          "title": "Answer",
          "type": "boolean"
        },
        "can_reach_end_without_result_code": {
          "title": "Can Reach End Without Result Code",
          "type": "boolean"
        },
        "reachable_result_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reachable Result Codes",
          "type": "array"
        },
        "step_number": {
          "title": "Step Number",
          "type": "string"
        }
      },
      "required": [
        "step_number",
        "answer",
        "reachable_result_codes",
        "can_reach_end_without_result_code"
      ],
      "title": "DecisionConsequence",
      "type": "object"
    },
    "EbdDocumentReleaseInformation": {
      "additionalProperties": false,
      "description": "Contains information from the title (first) page of the EDI@Energy document which contains all EBDs.",
      "properties": {
        "ebdamame_version": {
          "anyOf": [
            {
              "pattern": "^v\\d+\\.\\d+\\.\\d+.*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ebdamame Version"
        },
        "original_release_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Release Date"
        },
        "rebdhuhn_version": {
          "anyOf": [
            {
              "pattern": "^v\\d+\\.\\d+\\.\\d+.*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rebdhuhn Version"
        },
        "release_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Date"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "title": "EbdDocumentReleaseInformation",
      "type": "object"
    },
    "EbdGraphMetaData": {
      "additionalProperties": false,
      "description": "Metadata of an EBD graph",
      "properties": {
        "chapter": {
          "title": "Chapter",
          "type": "string"
        },
        "ebd_code": {
          "title": "Ebd Code",
          "type": "string"
        },
        "ebd_name": {
          "title": "Ebd Name",
          "type": "string"
        },
        "pruefidentifikatoren": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/EbdPruefidentifikator"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pruefidentifikatoren"
        },
        "release_information": {
          "anyOf": [
            {
              "$ref": "#/$defs/EbdDocumentReleaseInformation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "remark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remark"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "ebd_code",
        "chapter",
        "section",
        "ebd_name",
        "role"
      ],
      "title": "EbdGraphMetaData",
      "type": "object"
    },
    "EbdPruefidentifikator": {
      "additionalProperties": false,
      "description": "A Pruefidentifikator paired with its Edifact format version,\nallowing generation of links to ahb-tabellen.hochfrequenz.app.",
      "properties": {
        "format_version": {
          "$ref": "#/$defs/EdifactFormatVersion"
        },
        "pruefidentifikator": {
          "pattern": "^\\d{5}$",
          "title": "Pruefidentifikator",
          "type": "string"
        }
      },
      "required": [
        "format_version",
        "pruefidentifikator"
      ],
      "title": "EbdPruefidentifikator",
      "type": "object"
    },
    "EdifactFormatVersion": {
      "description": "One format version refers to the period in which an AHB is valid.",
      "enum": [
        "FV2104",
        "FV2110",
        "FV2210",
        "FV2304",
        "FV2310",
        "FV2404",
        "FV2410",
        "FV2504",
        "FV2510",
        "FV2604",
        "FV2610"
      ],
      "title": "EdifactFormatVersion",
      "type": "string"
    },
    "MultiStepInstruction": {
      "additionalProperties": false,
      "description": "This class generally models plain text instructions that shall be applied to multiple steps in an EBD from a\nspecified step number onwards. It'll be clearer with two examples.\n\nExample A:\nSometimes, the checks described in the EBDs are not thought to be performed once per message, but once per MaLo.\nIn German the instruction says: 'Je Marktlokation erfolgen die nachstehenden Pr\u00fcfungen:'\n\nExample B:\nSometimes the EBDs are not though to return only a single answer code but allow to collect multiple answer codes and\nreturn them all together. Technically this means: Don't exit the tree at the first sub row without a subsequent step\nbut continue and perform the following checks as well.\nIn German the instruction says:\n'Alle festgestellten Antworten sind anzugeben, soweit im Format m\u00f6glich (maximal 8 Antwortcodes)*.'",
      "properties": {
        "first_step_number_affected": {
          "pattern": "^\\d+\\*?$",
          "title": "First Step Number Affected",
          "type": "string"
        },
        "instruction_text": {
          "title": "Instruction Text",
          "type": "string"
        }
      },
      "required": [
        "first_step_number_affected",
        "instruction_text"
      ],
      "title": "MultiStepInstruction",
      "type": "object"
    },
    "OutcomeExplanation": {
      "additionalProperties": false,
      "description": "Explains which steps were passed on the way to an outcome.",
      "properties": {
        "certain_steps": {
          "items": {
            "$ref": "#/$defs/PassedStep"
          },
          "title": "Certain Steps",
          "type": "array"
        },
        "has_subsequent_steps": {
          "title": "Has Subsequent Steps",
          "type": "boolean"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "possible_steps": {
          "items": {
            "$ref": "#/$defs/PassedStep"
          },
          "title": "Possible Steps",
          "type": "array"
        },
        "result_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Code"
        },
        "route_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Route Count"
        },
        "routes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Route"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Routes"
        }
      },
      "required": [
        "key",
        "result_code",
        "notes",
        "has_subsequent_steps",
        "certain_steps",
        "possible_steps",
        "route_count",
        "routes"
      ],
      "title": "OutcomeExplanation",
      "type": "object"
    },
    "PassedStep": {
      "additionalProperties": false,
      "description": "A step that was passed on the way to an outcome.",
      "properties": {
        "answers": {
          "items": {
            "type": "boolean"
          },
          "title": "Answers",
          "type": "array"
        },
        "step_number": {
          "title": "Step Number",
          "type": "string"
        }
      },
      "required": [
        "step_number",
        "answers"
      ],
      "title": "PassedStep",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "description": "One concrete route from the start to an outcome.",
      "properties": {
        "steps": {
          "items": {
            "$ref": "#/$defs/RouteStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "title": "Route",
      "type": "object"
    },
    "RouteStep": {
      "additionalProperties": false,
      "description": "One step of one concrete route from the start to an outcome.",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Answer"
        },
        "step_number": {
          "title": "Step Number",
          "type": "string"
        }
      },
      "required": [
        "step_number",
        "answer"
      ],
      "title": "RouteStep",
      "type": "object"
    },
    "StepDescription": {
      "additionalProperties": false,
      "description": "The description of one step (a decision or a transition); the legend of an outcomes file.",
      "properties": {
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "step_number": {
          "title": "Step Number",
          "type": "string"
        }
      },
      "required": [
        "step_number",
        "question"
      ],
      "title": "StepDescription",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The outcome lookup of one EBD.",
  "properties": {
    "decisions": {
      "items": {
        "$ref": "#/$defs/DecisionConsequence"
      },
      "title": "Decisions",
      "type": "array"
    },
    "has_wildcard_outcome": {
      "title": "Has Wildcard Outcome",
      "type": "boolean"
    },
    "metadata": {
      "$ref": "#/$defs/EbdGraphMetaData"
    },
    "multi_step_instructions": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/MultiStepInstruction"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Multi Step Instructions"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/OutcomeExplanation"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepDescription"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "steps",
    "has_wildcard_outcome",
    "outcomes",
    "decisions"
  ],
  "title": "EbdOutcomes",
  "type": "object"
}
